{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM"],
    "types": ["@dcloudio/types", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "env.d.ts",
    "*.ts",
    "*.vue",
    "pages.json",
    "manifest.json",
    "uni.scss",
    "components/**/*.ts",
    "components/**/*.vue",
    "data/**/*.ts",
    "pages/**/*.ts",
    "pages/**/*.vue",
    "services/**/*.ts",
    "store/**/*.ts",
    "styles/**/*.css",
    "types/**/*.ts",
    "utils/**/*.ts",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
